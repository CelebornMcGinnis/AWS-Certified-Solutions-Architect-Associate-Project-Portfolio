# ----------------------------
# macOS / Windows system files
# ----------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini

# Finder/ZIP artifacts
__MACOSX/
*.zip

# ----------------------------
# Environment variables / secrets
# ----------------------------
.env
.env.*
!.env.example

# AWS credentials should never be committed
.aws/
credentials
config

# Local config files that may contain endpoint URLs or secrets
local-config.*
config.local.*
secrets.*
*.pem
*.key
*.crt

# ----------------------------
# AWS SAM / CloudFormation
# ----------------------------
.aws-sam/
samconfig.toml
packaged.yaml

# CloudFormation/SAM generated files
template-generated.yaml
template-packaged.yaml

# ----------------------------
# Python / Lambda backend
# ----------------------------
__pycache__/
*.py[cod]
*$py.class

.venv/
venv/
env/
ENV/

pip-wheel-metadata/
*.egg-info/
dist/
build/

.pytest_cache/
.coverage
htmlcov/

# ----------------------------
# Node / frontend tooling
# ----------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

package-lock.json
yarn.lock
pnpm-lock.yaml

# Keep lock files if you later add a real build system.
# For now, these can be ignored if your site is plain HTML/CSS/JS.

# ----------------------------
# IDE / editor files
# ----------------------------
.vscode/
.idea/
*.swp
*.swo

# ----------------------------
# Logs and temporary files
# ----------------------------
*.log
logs/
tmp/
temp/
.cache/

# ----------------------------
# Build outputs
# ----------------------------
out/
public/build/
coverage/

# ----------------------------
# Optional: generated diagram exports
# ----------------------------
*.drawio.bkp
