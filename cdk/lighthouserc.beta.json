{
  "ci": {
    "collect": {
      "url": [
        "https://betaweb.mcginnisarchitecture.com/",
        "https://betaweb.mcginnisarchitecture.com/project/linkedin/index.html",
        "https://betaweb.mcginnisarchitecture.com/project/contactform/project1.html",
        "https://betaweb.mcginnisarchitecture.com/project/habits/project6.html",
        "https://betaweb.mcginnisarchitecture.com/project/containers/index.html"
      ],
      "numberOfRuns": 2,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.8
          }
        ],
        "categories:accessibility": [
          "warn",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": "off",
        "document-title": [
          "warn",
          {
            "minScore": 1
          }
        ],
        "meta-description": [
          "warn",
          {
            "minScore": 1
          }
        ],
        "canonical": [
          "warn",
          {
            "minScore": 1
          }
        ],
        "link-text": [
          "warn",
          {
            "minScore": 1
          }
        ],
        "crawlable-anchors": [
          "warn",
          {
            "minScore": 1
          }
        ],
        "robots-txt": [
          "warn",
          {
            "minScore": 1
          }
        ],
        "image-alt": [
          "warn",
          {
            "minScore": 1
          }
        ],
        "viewport": [
          "warn",
          {
            "minScore": 1
          }
        ],
        "http-status-code": [
          "warn",
          {
            "minScore": 1
          }
        ],
        "is-crawlable": "off"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
