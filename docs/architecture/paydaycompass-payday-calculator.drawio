0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;labelBackgroundColor=#F5F5F5;fillColor=#DD344C;strokeColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.simple_email_service;" vertex="1" parent="1"><mxGeometry x="900" y="550" width="60" height="60" as="geometry"/></mxCell><mxCell id="peer" value="Someone you&lt;br&gt;share money with" style="sketch=0;outlineConnect=0;fontColor=#232F3E;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;labelBackgroundColor=#F5F5F5;fillColor=#232F3D;strokeColor=none;shape=mxgraph.aws4.client;" vertex="1" parent="1"><mxGeometry x="1180" y="550" width="60" height="60" as="geometry"/></mxCell><mxCell id="sweep" value="Shared layer&lt;br&gt;payday sweep +&lt;br&gt;transfers" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;labelBackgroundColor=#F5F5F5;fillColor=#ED7100;strokeColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="600" y="550" width="60" height="60" as="geometry"/></mxCell><mxCell id="funds" value="DynamoDB&lt;br&gt;accounts + divisions" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;labelBackgroundColor=#F5F5F5;fillColor=#C925D1;strokeColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1"><mxGeometry x="600" y="770" width="60" height="60" as="geometry"/></mxCell><mxCell id="note0" value="&lt;b&gt;Why it exists&lt;/b&gt;&lt;br&gt;Shows what a paycheck covers before it lands. Recurring bills, budget set-asides, and planned expenses are totalled together. When submitted, everything posts in one batch; a daily job never double-posts the same bill. Past paydays can be reversed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;fontSize=12;align=left;spacing=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="220" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>