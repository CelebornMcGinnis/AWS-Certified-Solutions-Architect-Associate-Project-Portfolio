LabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;labelBackgroundColor=#F5F5F5;fillColor=#ED7100;strokeColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="280" y="780" width="60" height="60" as="geometry"/></mxCell><mxCell id="agr" value="DynamoDB&lt;br&gt;peer agreements" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;labelBackgroundColor=#F5F5F5;fillColor=#C925D1;strokeColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1"><mxGeometry x="520" y="780" width="60" height="60" as="geometry"/></mxCell><mxCell id="pn" value="DynamoDB&lt;br&gt;notifications" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;labelBackgroundColor=#F5F5F5;fillColor=#C925D1;strokeColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1"><mxGeometry x="760" y="780" width="60" height="60" as="geometry"/></mxCell><mxCell id="ses2" value="Amazon SES&lt;br&gt;alert email" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;labelBackgroundColor=#F5F5F5;fillColor=#DD344C;strokeColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.simple_email_service;" vertex="1" parent="1"><mxGeometry x="1000" y="780" width="60" height="60" as="geometry"/></mxCell><mxCell id="rcp" value="Agreed recipient" style="sketch=0;outlineConnect=0;fontColor=#232F3E;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;labelBackgroundColor=#F5F5F5;fillColor=#232F3D;strokeColor=none;shape=mxgraph.aws4.client;" vertex="1" parent="1"><mxGeometry x="1240" y="780" width="60" height="60" as="geometry"/></mxCell><mxCell id="note0" value="&lt;b&gt;Security, at a high level&lt;/b&gt;&lt;br&gt;&amp;bull; Every request carries a signed token that API Gateway checks before any code runs.&lt;br&gt;&amp;bull; MFA is supported for sign-in.&lt;br&gt;&amp;bull; Data access is checked for every account: the owner, or someone the owner shared with, at the permission level they chose.&lt;br&gt;&amp;bull; Alerts about fund movement need a separate mutual agreement.&lt;br&gt;&amp;bull; Functions are granted only the tables they need." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;fontSize=12;align=left;spacing=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="780" y="330" width="320" height="230" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>