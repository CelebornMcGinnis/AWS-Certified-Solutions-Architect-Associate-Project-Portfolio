ed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;labelBackgroundColor=#F5F5F5;fillColor=#ED7100;strokeColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="600" y="550" width="60" height="60" as="geometry"/></mxCell><mxCell id="cw" value="CloudWatch alarm&lt;br&gt;on errors, emails&lt;br&gt;the owner (SNS)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;labelBackgroundColor=#F5F5F5;fillColor=#E7157B;strokeColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1"><mxGeometry x="320" y="550" width="60" height="60" as="geometry"/></mxCell><mxCell id="note0" value="&lt;b&gt;Built to keep going&lt;/b&gt;&lt;br&gt;Each template runs on its own, so one bad record never blocks anyone else. Missed days are backfilled. The user is emailed the same day a bill could not post, and the owner is alerted separately." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;fontSize=12;align=left;spacing=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="220" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>