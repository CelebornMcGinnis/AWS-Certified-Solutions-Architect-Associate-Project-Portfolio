"40" y="520" width="220" height="230" as="geometry"/></mxCell><mxCell id="note1" value="Nothing fits? It suggests a new category and the customer decides." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;fontSize=12;align=left;spacing=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="880" y="110" width="330" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>